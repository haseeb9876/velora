ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: Neon connection string with sslmode=require. Without it, local SQLite is used.
DATABASE_URL=
# Used to create download URLs. Empty uses the request's origin locally.
PUBLIC_WORKER_URL=
# Enable ONLY behind your trusted local reverse proxy or Tailscale Funnel.
TRUST_LOCAL_PROXY=false
MAX_CONCURRENT=1
MAX_QUEUE=20
MAX_PLAYLIST=10
MAX_DURATION=1800
MAX_FILE_MB=500
MAX_STORAGE_MB=2000
FILE_TTL_HOURS=2
JOB_TIMEOUT_SECONDS=900
RATE_LIMIT_PER_HOUR=40

# Optional override, e.g. node:/absolute/path/to/node or deno:/absolute/path/to/deno
# Defaults to the project-local Node runtime installed by npm.
# JS_RUNTIME=
