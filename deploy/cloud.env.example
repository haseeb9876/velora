# Runtime secrets belong in deploy/cloud.env on the VM, never in Git.
# Start cloud smoke tests with DATABASE_URL empty (isolated SQLite).
# Only connect production Neon after the old worker is stopped and migration is complete.
DATABASE_URL=
ALLOWED_ORIGINS=https://velora-downloader.vercel.app
PUBLIC_WORKER_URL=https://replace-with-backend-hostname
MAX_CONCURRENT=1
MAX_QUEUE=20
MAX_PLAYLIST=10
MAX_DURATION=1800
MAX_FILE_MB=500
MAX_STORAGE_MB=2000
FILE_TTL_HOURS=2
JOB_TIMEOUT_SECONDS=900
RATE_LIMIT_PER_HOUR=40
